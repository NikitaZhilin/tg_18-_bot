BOT_TOKEN=
# Кто играет в личке с ботом. Для групп ID не нужны: группа открывается паролем из админки
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_IDS=
PLAYER_1_NAME=Player 1
PLAYER_2_NAME=Player 2
BOT_TIMEZONE=Europe/Moscow
DATA_DIR=./data
DATABASE_PATH=./data/bot.sqlite3
LOG_LEVEL=INFO
DRY_RUN=false
ALLOW_UNLISTED_USERS=false
# Исторический флаг: в личке и так играют вдвоём с одного аккаунта
SINGLE_ACCOUNT_TWO_PLAYERS=false
# true — перед первой игрой за день оба игрока подтверждают участие
REQUIRE_DAILY_CONSENT=false
# Больше не используется: «Экстрим» включается кнопкой в меню
ADMIN_CONTENT_PASSWORD_SHA256=
TELEGRAM_PROXY_URL=
